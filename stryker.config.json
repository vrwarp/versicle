{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Scoped mutation testing over the sync, reader and library domains \u2014 see vitest.mutation.config.ts for the scope rationale and for why `include` is replaced rather than merged (mergeConfig concatenates arrays, which silently runs the whole 3,300-test suite once per mutant).",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.mutation.config.ts"
  },
  "reporters": [
    "html",
    "clear-text",
    "progress"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "coverageAnalysis": "perTest",
  "concurrency": 3,
  "timeoutMS": 30000,
  "mutate": [
    "src/domains/sync/**/*.ts",
    "src/domains/reader/**/*.ts",
    "src/domains/reader/**/*.tsx",
    "src/domains/library/**/*.ts",
    "src/app/sync/**/*.ts",
    "!src/**/*.{test,spec}.{ts,tsx}",
    "!src/domains/sync/backend/Mock*.ts",
    "!src/domains/reader/engine/FakeReaderEngine.ts"
  ],
  "thresholds": {
    "high": 90,
    "low": 70,
    "break": 0
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true
}
